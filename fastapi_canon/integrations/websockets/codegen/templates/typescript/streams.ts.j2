export type BinaryStreamDirection =
  "server-to-client" | "client-to-server" | "bidirectional";

{{ "BinaryStreamName" | union_alias(streams | map(attribute="name")) }}

export type BinaryStreamEndpoint = {
  readonly name: BinaryStreamName;
  readonly url: string | URL;
  readonly direction: BinaryStreamDirection;
  readonly contentType?: string;
  readonly inputContentType?: string;
  readonly subprotocols?: readonly string[];
};

export type BinaryFrame = ArrayBuffer | ArrayBufferView;

/** The text message that ends a stream's input; output keeps flowing. */
export type BinaryInputEnd = { readonly type: "end" };

export type BinaryStreamTransport = {
  receive(): Promise<ArrayBuffer>;
  close(): Promise<void>;
  send?(frame: BinaryFrame): Promise<void>;
  endInput?(): Promise<void>;
};

/** A stream transport that can also send frames to the server. */
export type BinaryInputTransport = BinaryStreamTransport & {
  send(frame: BinaryFrame): Promise<void>;
  endInput(): Promise<void>;
};

export type BinaryStreamOpener = (
  endpoint: BinaryStreamEndpoint,
) => Promise<BinaryStreamTransport>;

/** Raised when the server did not close a completed upload in time. */
export class RpcStreamTimeout extends Error {
  readonly timeoutMs: number;

  constructor(timeoutMs: number) {
    super(`The server did not close the binary stream within ${timeoutMs} ms`);
    this.timeoutMs = timeoutMs;
  }
}

/** Receives the frames of a server-to-client stream. */
export class BinaryReceiver implements AsyncIterable<ArrayBuffer> {
  readonly #transport: BinaryStreamTransport;

  constructor(transport: BinaryStreamTransport) {
    this.#transport = transport;
  }

  receive(): Promise<ArrayBuffer> {
    return this.#transport.receive();
  }

  async *[Symbol.asyncIterator](): AsyncIterator<ArrayBuffer> {
    try {
      while (true) yield await this.receive();
    } catch (error) {
      if (!(error instanceof RpcStreamClosed)) throw error;
    }
  }

  close(): Promise<void> {
    return this.#transport.close();
  }

  [Symbol.asyncDispose](): Promise<void> {
    return this.close();
  }
}

/** Sends and receives frames concurrently on a bidirectional stream. */
export class BinaryChannel extends BinaryReceiver {
  readonly #input: BinaryInputTransport;
  #inputEnded = false;

  constructor(transport: BinaryInputTransport) {
    super(transport);
    this.#input = transport;
  }

  /** Send one frame. */
  send(frame: BinaryFrame): Promise<void> {
    if (this.#inputEnded) return Promise.reject(inputEnded());
    return this.#input.send(frame);
  }

  /** Tell the server that no more frames follow; output keeps flowing. */
  endInput(): Promise<void> {
    if (this.#inputEnded) return Promise.reject(inputEnded());
    this.#inputEnded = true;
    return this.#input.endInput();
  }
}

/**
 * Sends the frames of a client-to-server stream. Call `end()` to complete it;
 * closing or disposing without `end()` aborts the stream.
 */
export class BinarySender {
  readonly #transport: BinaryInputTransport;
  #inputEnded = false;

  constructor(transport: BinaryInputTransport) {
    this.#transport = transport;
  }

  /** Send one frame. */
  send(frame: BinaryFrame): Promise<void> {
    if (this.#inputEnded) return Promise.reject(inputEnded());
    return this.#transport.send(frame);
  }

  /**
   * End the input and wait until the server accepted it by closing. Rejects
   * with `RpcStreamTimeout` after `timeoutMs` (default 30 s); pass `Infinity`
   * to wait without a limit.
   */
  async end(options: { readonly timeoutMs?: number } = {}): Promise<void> {
    const timeoutMs = options.timeoutMs ?? 30_000;
    const completion = this.#complete();
    if (!Number.isFinite(timeoutMs)) return completion;
    completion.catch(() => undefined);
    let timer: ReturnType<typeof setTimeout> | undefined;
    const timeout = new Promise<never>((_, reject) => {
      timer = setTimeout(
        () => reject(new RpcStreamTimeout(timeoutMs)),
        timeoutMs,
      );
    });
    try {
      await Promise.race([completion, timeout]);
    } finally {
      clearTimeout(timer);
    }
  }

  async #complete(): Promise<void> {
    if (!this.#inputEnded) {
      this.#inputEnded = true;
      await this.#transport.endInput();
    }
    try {
      await this.#transport.receive();
    } catch (error) {
      if (error instanceof RpcStreamClosed) return;
      throw error;
    }
    throw new Error("The server sent a frame on a client-to-server stream");
  }

  close(): Promise<void> {
    return this.#transport.close();
  }

  [Symbol.asyncDispose](): Promise<void> {
    return this.close();
  }
}

function inputEnded(): RpcStreamClosed {
  return new RpcStreamClosed("The binary input already ended");
}

