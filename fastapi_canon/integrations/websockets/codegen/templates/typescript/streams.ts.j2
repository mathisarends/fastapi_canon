export type BinaryWebSocketOptions = {
  readonly incomingQueueSize?: number;
  readonly socketFactory?: BinaryWebSocketFactory;
};

type BinaryCloseEvent = { readonly code?: number; readonly reason?: string };

type BinaryWebSocket = {
  binaryType: string;
  readonly readyState: number;
  send(data: string | BinaryFrame): void;
  close(): void;
  addEventListener(
    type: "open" | "close" | "error",
    listener: (event?: BinaryCloseEvent) => void,
  ): void;
  addEventListener(
    type: "message",
    listener: (event: { readonly data: unknown }) => void,
  ): void;
};

export class BinaryWebSocketStream implements BinaryStreamTransport {
  readonly endpoint: BinaryStreamEndpoint;
  readonly #socket: BinaryWebSocket;
  readonly #frames: BinaryFrameQueue;
  #closed = false;

  private constructor(
    socket: BinaryWebSocket,
    endpoint: BinaryStreamEndpoint,
    incomingQueueSize: number,
  ) {
    this.#socket = socket;
    this.endpoint = endpoint;
    this.#frames = new BinaryFrameQueue(incomingQueueSize);
    socket.binaryType = "arraybuffer";
    socket.addEventListener("message", (event) => {
      try {
        if (event.data instanceof ArrayBuffer) this.#frames.push(event.data);
        else throw new Error("The binary WebSocket returned a text frame");
      } catch (error) {
        this.#fail(
          error instanceof Error ? error : new Error("Invalid binary frame"),
        );
        socket.close();
      }
    });
    socket.addEventListener("error", () =>
      this.#fail(new Error("The binary WebSocket connection failed")),
    );
    socket.addEventListener("close", (event) => {
      const code = event?.code ?? 1000;
      if (code === 1000 || code === 1001) this.#end();
      else {
        const failure = code === 1008 ? RpcStreamRefused : RpcStreamFailed;
        this.#fail(new failure(code, event?.reason ?? ""));
      }
    });
  }

  static async open(
    endpoint: BinaryStreamEndpoint,
    options: BinaryWebSocketOptions = {},
  ): Promise<BinaryWebSocketStream> {
    const socketFactory =
      options.socketFactory ?? defaultBinaryWebSocketFactory;
    const incomingQueueSize = options.incomingQueueSize ?? 100;
    if (!Number.isInteger(incomingQueueSize) || incomingQueueSize <= 0) {
      throw new Error("incomingQueueSize must be a positive integer");
    }
    const socket = socketFactory(endpoint.url, endpoint.subprotocols);
    socket.binaryType = "arraybuffer";
    await waitForOpen(socket);
    return new BinaryWebSocketStream(socket, endpoint, incomingQueueSize);
  }

  receive(): Promise<ArrayBuffer> {
    if (this.#closed)
      return Promise.reject(new RpcStreamClosed("The binary stream is closed"));
    return this.#frames.receive();
  }

  send(frame: BinaryFrame): Promise<void> {
    if (this.#closed)
      return Promise.reject(new RpcStreamClosed("The binary stream is closed"));
    this.#socket.send(frame);
    return Promise.resolve();
  }

  endInput(): Promise<void> {
    if (this.#closed)
      return Promise.reject(new RpcStreamClosed("The binary stream is closed"));
    const end: BinaryInputEnd = { type: "end" };
    this.#socket.send(JSON.stringify(end));
    return Promise.resolve();
  }

  async close(): Promise<void> {
    if (this.#closed) return;
    this.#closed = true;
    this.#socket.close();
    this.#end();
  }

  #end(): void {
    this.#closed = true;
    this.#frames.fail(new RpcStreamClosed("The binary stream is closed"));
  }

  #fail(error: Error): void {
    if (this.#closed) return;
    this.#closed = true;
    this.#frames.fail(error);
  }
}

class BinaryFrameQueue {
  readonly #capacity: number;
  readonly #values: ArrayBuffer[] = [];
  readonly #waiters: Array<{
    readonly resolve: (value: ArrayBuffer) => void;
    readonly reject: (error: unknown) => void;
  }> = [];
  #failure?: unknown;

  constructor(capacity: number) {
    this.#capacity = capacity;
  }

  receive(): Promise<ArrayBuffer> {
    const value = this.#values.shift();
    if (value !== undefined) return Promise.resolve(value);
    if (this.#failure !== undefined) return Promise.reject(this.#failure);
    return new Promise((resolve, reject) =>
      this.#waiters.push({ resolve, reject }),
    );
  }

  push(value: ArrayBuffer): void {
    const waiter = this.#waiters.shift();
    if (waiter !== undefined) waiter.resolve(value);
    else {
      if (this.#values.length === this.#capacity) {
        throw new Error("The binary WebSocket frame queue overflowed");
      }
      this.#values.push(value);
    }
  }

  fail(error: unknown): void {
    if (this.#failure !== undefined) return;
    this.#failure = error;
    for (const waiter of this.#waiters.splice(0)) waiter.reject(error);
  }
}

function defaultBinaryWebSocketFactory(
  url: string | URL,
  protocols?: readonly string[],
): BinaryWebSocket {
  const constructor = (
    globalThis as unknown as {
      readonly WebSocket?: new (
        url: string | URL,
        protocols?: readonly string[],
      ) => BinaryWebSocket;
    }
  ).WebSocket;
  if (constructor === undefined) {
    throw new Error(
      "No global WebSocket implementation is available; provide socketFactory",
    );
  }
  return new constructor(url, protocols);
}

function waitForOpen(socket: BinaryWebSocket): Promise<void> {
  if (socket.readyState === 1) return Promise.resolve();
  return new Promise((resolve, reject) => {
    socket.addEventListener("open", () => resolve());
    socket.addEventListener("error", () =>
      reject(new Error("Binary WebSocket open failed")),
    );
    socket.addEventListener("close", () =>
      reject(new Error("Binary WebSocket closed")),
    );
  });
}
