  "info": {
    "title": "FastAPI",
    "version": "0.1.0"
  },
  "openapi": "3.2.0",
  "paths": {
    "/projects/{project_id}": {
      "get": {
        "operationId": "get",
        "parameters": [
          {
            "in": "path",
            "name": "project_id",
            "required": true,
            "schema": {
              "title": "Project Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Project"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectMissingProblem"
                }
              }
            },
            "description": "Project not found"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestValidationProblem"
                }
              }
            },
            "description": "Request validation failed"
          }
        },
        "summary": "Get Project",
        "tags": [
          "projects"
        ]
      }
    },
    "/projects/{project_id}/events": {
      "get": {
        "operationId": "events",
        "parameters": [
          {
            "in": "path",
            "name": "project_id",
            "required": true,
            "schema": {
              "title": "Project Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "text/event-stream": {
                "itemSchema": {
                  "oneOf": [
                    {
                      "properties": {
                        "data": {
                          "contentMediaType": "application/json",
                          "contentSchema": {
                            "$ref": "#/components/schemas/ProjectEvent"
                          },
                          "type": "string"
                        },
                        "event": {
                          "not": {
                            "pattern": "^canon\\."
                          },
                          "type": "string"
                        },
                        "id": {
                          "type": "string"
                        },
                        "retry": {
                          "minimum": 0,
                          "type": "integer"
                        }
                      },
                      "required": [
                        "data"
                      ],
                      "type": "object"
                    },
                    {
                      "properties": {
                        "data": {
                          "contentMediaType": "application/json",
                          "contentSchema": {
                            "anyOf": [
                              {
                                "$ref": "#/components/schemas/ProjectMissingProblemEmbedded"
                              },
                              {
                                "$ref": "#/components/schemas/CanonInternalServerErrorEmbedded"
                              }
                            ]
                          },
                          "type": "string"
                        },
                        "event": {
                          "const": "canon.problem",
                          "type": "string"
                        }
                      },
                      "required": [
                        "event",
                        "data"
                      ],
                      "type": "object"
                    },
                    {
                      "properties": {
                        "data": {
                          "contentMediaType": "application/json",
                          "contentSchema": {
                            "maxProperties": 0,
                            "type": "object"
                          },
                          "type": "string"
                        },
                        "event": {
                          "const": "canon.complete",
                          "type": "string"
                        }
                      },
                      "required": [
                        "event",
                        "data"
                      ],
                      "type": "object"
                    }
                  ]
                }
              }
            },
            "description": "Stream of JSON events"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectMissingProblem"
                }
              }
            },
            "description": "Project not found"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestValidationProblem"
                }
              }
            },
            "description": "Request validation failed"
          }
        },
        "summary": "Events",
        "tags": [
          "projects"
        ],
        "x-canon-stream": {
          "businessItemSchema": {
            "properties": {
              "data": {
                "contentMediaType": "application/json",
                "contentSchema": {
                  "$ref": "#/components/schemas/ProjectEvent"
                },
                "type": "string"
              },
              "event": {
                "type": "string"
              },
              "id": {
                "type": "string"
              },
              "retry": {
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "data"
            ],
            "type": "object"
          },
          "completeEvent": "canon.complete",
          "problemEvent": "canon.problem",
          "problems": [
            {
              "$ref": "#/components/schemas/ProjectMissingProblemEmbedded"
            }
          ],
          "version": 1
        }
      }
    }
  }
}
