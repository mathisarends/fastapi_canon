def resolve_endpoints(
    variables: Mapping[str, str | None] | None = None,
    overrides: Mapping[ServerName, str | Endpoint] | None = None,
) -> tuple[Endpoint, ...]:
    """Resolve every declared server, then apply the caller's overrides."""
    resolved = {server: endpoint(server, variables) for server in _SERVERS}
    for server, override in (overrides or {}).items():
        if server not in resolved:
            raise ValueError(f"Unknown server {server!r}")
        if isinstance(override, Endpoint) and override.server != server:
            raise ValueError(
                f"Endpoint override for {server!r} declares {override.server!r}"
            )
        resolved[server] = (
            override
            if isinstance(override, Endpoint)
            else replace(resolved[server], url=_websocket_url(override))
        )
    return tuple(resolved.values())


def _websocket_url(url: str) -> str:
    if url.startswith("https://"):
        return "wss://" + url[8:]
    if url.startswith("http://"):
        return "ws://" + url[7:]
    return url
