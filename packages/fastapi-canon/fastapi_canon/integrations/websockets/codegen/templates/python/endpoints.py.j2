def endpoint(
    server: ServerName, values: Mapping[str, str | None] | None = None
) -> Endpoint:
    """Resolve one declared server, ignoring variables it does not declare."""
    info = _SERVERS[server]
    supplied = {
        name: value
        for name, value in (values or {}).items()
        if name in info.variables and value is not None
    }
    return Endpoint(
        server=server,
        url=info.resolve(supplied),
        subprotocols=info.transport.subprotocols if info.transport else (),
    )
