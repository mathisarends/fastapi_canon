@asynccontextmanager
async def open_socket(
    endpoint: SocketEndpoint, opener: SocketOpener | None
) -> AsyncGenerator[{{ "Socket[Any, Any]" if typed else "Socket" }}, None]:
    """Open a socket for one ``async with`` block and close it when it ends."""
    if opener is None:
        raise RpcStreamsUnavailableError(
            "No socket opener configured; pass socket_opener=..."
        )
    async with Socket(await opener(endpoint), endpoint) as socket:
        yield socket
