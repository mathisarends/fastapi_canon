type SocketMessageType = Literal["text", "binary"]
type SocketMessage = str | bytes


@dataclass(frozen=True, slots=True)
class SocketProtocol:
    """Declared protocol metadata; this alone does not enable message validation."""

    name: str
    encoding: str = "json"
    version: str | None = None
    schemas: tuple[str, ...] = ()


@dataclass(frozen=True, slots=True)
class SocketEndpoint:
    name: SocketName
    url: str
    message_types: tuple[SocketMessageType, ...] = ("text", "binary")
    subprotocols: tuple[str, ...] = ()
    protocol: SocketProtocol | None = None


@dataclass(frozen=True, slots=True)
class SocketInfo:
    """One declared socket, before its variables are filled in."""

    name: SocketName
    url: str
    message_types: tuple[SocketMessageType, ...] = ("text", "binary")
    subprotocols: tuple[str, ...] = ()
    variables: Mapping[str, RpcServerVariable] = field(default_factory=dict)
    protocol: SocketProtocol | None = None

    def __post_init__(self) -> None:
        object.__setattr__(self, "variables", MappingProxyType(dict(self.variables)))


def resolve_socket_endpoint(
    socket: SocketInfo,
    connected: Mapping[str, str] | None = None,
    values: Mapping[str, str | None] | None = None,
) -> SocketEndpoint:
    """Fill a socket URL from the call's values, then the client's connect values."""
    supplied = {
        **{
            name: value
            for name, value in (connected or {}).items()
            if name in socket.variables
        },
        **{name: value for name, value in (values or {}).items() if value is not None},
    }
    return SocketEndpoint(
        name=socket.name,
        url=resolve_url_template(
            f"socket {socket.name.value!r}",
            socket.url,
            socket.variables,
            supplied,
        ),
        message_types=socket.message_types,
        subprotocols=socket.subprotocols,
        protocol=socket.protocol,
    )


class SocketTransport(Protocol):
    """Receives ``RpcStreamClosed`` once the server closed the socket normally."""

    async def receive(self) -> SocketMessage: ...

    async def send(self, message: SocketMessage) -> None: ...

    async def close(self) -> None: ...


type SocketOpener = Callable[[SocketEndpoint], Awaitable[SocketTransport]]


