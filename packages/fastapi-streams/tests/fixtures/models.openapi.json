{
  "components": {
    "schemas": {
      "DoneEvent": {
        "properties": {
          "count": {
            "title": "Count",
            "type": "integer"
          },
          "type": {
            "const": "done",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "count"
        ],
        "title": "DoneEvent",
        "type": "object"
      },
      "FixtureEvent": {
        "discriminator": {
          "mapping": {
            "done": "#/components/schemas/DoneEvent",
            "nested": "#/components/schemas/NestedEvent"
          },
          "propertyName": "type"
        },
        "oneOf": [
          {
            "$ref": "#/components/schemas/NestedEvent"
          },
          {
            "$ref": "#/components/schemas/DoneEvent"
          }
        ]
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Metadata": {
        "properties": {
          "labels": {
            "items": {
              "type": "string"
            },
            "title": "Labels",
            "type": "array"
          },
          "limits": {
            "additionalProperties": {
              "type": "integer"
            },
            "title": "Limits",
            "type": "object"
          },
          "mode": {
            "default": "fast",
            "enum": [
              "fast",
              "full"
            ],
            "title": "Mode",
            "type": "string"
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          }
        },
        "required": [
          "labels",
          "limits"
        ],
        "title": "Metadata",
        "type": "object"
      },
      "NestedEvent": {
        "properties": {
          "children": {
            "items": {
              "$ref": "#/components/schemas/NestedEvent"
            },
            "title": "Children",
            "type": "array"
          },
          "external-id": {
            "title": "External-Id",
            "type": "string"
          },
          "metadata": {
            "$ref": "#/components/schemas/Metadata"
          },
          "type": {
            "const": "nested",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "external-id",
          "metadata"
        ],
        "title": "NestedEvent",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "FastAPI",
    "version": "0.1.0"
  },
  "openapi": "3.2.0",
  "paths": {
    "/nested/{item_id}": {
      "get": {
        "operationId": "nested_events",
        "parameters": [
          {
            "in": "path",
            "name": "item_id",
            "required": true,
            "schema": {
              "title": "Item Id",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "labels",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Labels"
            }
          },
          {
            "in": "header",
            "name": "x-trace",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Trace"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "text/event-stream": {
                "itemSchema": {
                  "properties": {
                    "data": {
                      "contentMediaType": "application/json",
                      "contentSchema": {
                        "$ref": "#/components/schemas/FixtureEvent"
                      },
                      "type": "string"
                    },
                    "event": {
                      "type": "string"
                    },
                    "id": {
                      "type": "string"
                    },
                    "retry": {
                      "minimum": 0,
                      "type": "integer"
                    }
                  },
                  "required": [
                    "data"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Stream of JSON events"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Nested Events",
        "tags": [
          "fixtures"
        ]
      }
    }
  }
}
